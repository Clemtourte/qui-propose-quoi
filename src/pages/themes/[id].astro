---
import Base from '../../layouts/Base.astro';
import Item from '../../components/Item.astro';
import Section from '../../components/Section.astro';
import Survol from '../../components/Survol.astro';
import Comparateur from '../../components/Comparateur.astro';
import AvisCard from '../../components/AvisCard.astro';
import VerifCard from '../../components/VerifCard.astro';
import SourceRefs from '../../components/SourceRefs.astro';
import SourceList from '../../components/SourceList.astro';
import NatureTag from '../../components/NatureTag.astro';
import Legende from '../../components/Legende.astro';
import Initiales from '../../components/Initiales.astro';
import { getEntry } from 'astro:content';
import { getThemes, getThemeData, entryAnchor, absenceSur, typo, formatDate } from '../../lib/data';

export async function getStaticPaths() {
  const themes = await getThemes();
  return themes.map((t) => ({ params: { id: t.id }, props: { theme: t } }));
}

const { theme } = Astro.props;
const t = theme.data;
const { candidats, parCandidat, etat, avis, verifications, promesses, sources } = await getThemeData(theme);
// Key figures from the overview, each linked to the first source of its statement.
const chiffres = await Promise.all(
  etat.flatMap((e) =>
    e.chiffres_cles.map(async (c) => {
      // "5,1 % du PIB" -> big "5,1 %" + smaller "du PIB"; values starting with a word stay whole.
      const m = c.valeur.match(/^([\d\s,.%+−-]*\d[\d\s,.%]*?)\s+([A-Za-zÀ-ÿ].*)$/);
      return {
        ...c,
        nombre: m ? m[1] : c.valeur,
        unite: m ? m[2] : '',
        date: e.date,
        source: await getEntry(e.sources[0]),
      };
    }),
  ),
);
const nom = (id: string) => {
  const c = candidats.find((x) => x.id === id)!;
  return `${c.data.prenom} ${c.data.nom}`;
};
---

<Base
  title={t.titre}
  description={`${t.titre} : ce que propose chaque candidat à la présidentielle 2027, avec sources.`}
  indexType="Thème"
>
  <div class="wrap">
    <header class="hero prose">
      <p class="eyebrow">Thème</p>
      <h1>{t.titre}</h1>
      <p class="accroche">{t.accroche}</p>
      <Legende />
    </header>

    <section class="etat" aria-labelledby="etat-titre">
      <h2 id="etat-titre">État des lieux</h2>
      {
        chiffres.length > 0 && (
          <ul class="chiffres-cles">
            {chiffres.map((c) => (
              <li>
                <span class="valeur">
                  {typo(c.nombre)}
                  {c.unite && <span class="unite">{typo(c.unite)}</span>}
                </span>
                <span class="libelle">{typo(c.libelle)}</span>
                {c.source && (
                  <a class="src" href={c.source.data.url} target="_blank" rel="noopener noreferrer">
                    {c.source.data.media}, {formatDate(c.date)}
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
              </li>
            ))}
          </ul>
        )
      }
      {
        etat.length ? (
          chiffres.length > 0 ? (
            <details class="etat-detail">
              <summary>Lire l'état des lieux complet ({etat.length} éléments, avec les projections et les évaluations)</summary>
              <div class="stack">
                {etat.map((e) => (
                  <Item {...e} />
                ))}
              </div>
            </details>
          ) : (
            <div class="stack">
              {etat.map((e) => (
                <Item {...e} />
              ))}
            </div>
          )
        ) : (
          <p class="nd">
            <strong>Non documenté.</strong> Pas encore recherché.
          </p>
        )
      }
    </section>

    {
      t.questions.length > 0 && (
        <section class="survol" aria-labelledby="survol-titre" data-pagefind-ignore>
          <h2 id="survol-titre">En un coup d'œil</h2>
          <p class="muted note">
            <NatureTag nature="position" /> Ce que déclarent les candidats. Détail et sources dans les cartes plus bas.
          </p>
          <Survol questions={t.questions} parCandidat={parCandidat} themeId={theme.id} />
        </section>
      )
    }

    <Comparateur questions={t.questions} parCandidat={parCandidat} themeId={theme.id} />

    <section class="cartes" aria-labelledby="cartes-titre">
      <h2 id="cartes-titre">Candidat par candidat</h2>
      <p class="muted note">Ordre alphabétique.</p>
      {
        parCandidat.map(({ candidat: c, synthese, mesures, passe }) => {
          const bilan = passe.filter((e) => e.data.rubrique === 'bilan');
          // Why the card is empty when the candidate has no summary on this theme.
          const abs = synthese ? null : absenceSur(c, theme.id);
          return (
            <details class="carte" id={`carte-${c.id}`}>
              <summary>
                <Initiales prenom={c.data.prenom} nom={c.data.nom} size="sm" />
                <span class="corps">
                  <span class="qui">
                    <span class="nom">
                      {c.data.prenom} {c.data.nom}
                    </span>
                    <span class="parti">{c.data.parti}</span>
                  </span>
                  {synthese ? (
                    <span class="phrase">{typo(synthese.data.phrase)}</span>
                  ) : (
                    <span class="phrase nd-inline">{abs!.label} sur ce thème.</span>
                  )}
                </span>
                <span class="plus" aria-hidden="true" />
              </summary>
              <div class="detail">
                {synthese && <SourceRefs sources={synthese.data.sources} />}
                <h3>Mesures</h3>
                {mesures.length ? (
                  mesures.map((e) => (
                    <Item {...e.data} id={entryAnchor(e.id)} theme={undefined} qui={`${c.data.prenom} ${c.data.nom}`} />
                  ))
                ) : abs ? (
                  <div class="nd">
                    <p>
                      <strong>{abs.label}.</strong> {abs.note ?? 'Aucune recherche notée pour cette case.'}
                    </p>
                    {abs.sources.length > 0 && <SourceRefs sources={abs.sources} />}
                  </div>
                ) : (
                  <p class="nd">Aucune mesure détaillée saisie sur ce thème.</p>
                )}
                <h3>Bilan sur ce thème</h3>
                {bilan.length ? bilan.map((e) => (
                    <Item {...e.data} id={entryAnchor(e.id)} theme={undefined} qui={`${c.data.prenom} ${c.data.nom}`} />
                  )) : <p class="nd">Aucun bilan saisi sur ce thème.</p>}
                <p class="lien">
                  <a href={`/candidats/${c.id}/`}>
                    Voir le projet d'ensemble de {c.data.prenom} {c.data.nom} →
                  </a>
                </p>
              </div>
            </details>
          );
        })
      }
    </section>

    <div class="sections">
      {
        // Hidden while empty: too few opinions collected so far to keep an empty section on every theme.
        avis.length > 0 && (
          <Section id="avis" titre="Avis d'institutions" count={avis.length} recherche={t.recherches.avis}>
            {avis.map((a) => <AvisCard avis={a} showCandidats />)}
          </Section>
        )
      }
      <Section id="verifications" titre="Affirmations vérifiées" count={verifications.length} recherche={t.recherches.verifications}>
        {verifications.map((v) => <VerifCard verification={v} showCandidat />)}
      </Section>
      <Section id="promesses" titre="Promesses passées" count={promesses.length} recherche={t.recherches.promesses}>
        {
          promesses.map((e) => (
            <div class="promesse-bloc">
              <p class="promesse-qui">
                <a href={`/candidats/${e.data.candidat.id}/`}>{nom(e.data.candidat.id)}</a>
              </p>
              <Item {...e.data} theme={undefined} qui={nom(e.data.candidat.id)} />
            </div>
          ))
        }
      </Section>
    </div>

    <SourceList sources={sources} derniereVerification={t.derniere_verification} />
  </div>
</Base>

<style>
  .hero {
    margin-bottom: 1.5rem;
  }
  .accroche {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    color: var(--muted);
  }
  h2 {
    margin-top: 0;
  }
  .etat,
  .survol,
  .cartes {
    margin-top: 2.5rem;
  }
  .etat {
    margin-top: 0;
  }
  .stack {
    display: grid;
    gap: 0.75rem;
  }
  .chiffres-cles {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11.5rem, 1fr));
    gap: 0.75rem;
    max-width: 56rem;
  }
  .chiffres-cles li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 4px solid var(--fait);
    border-radius: var(--radius);
  }
  .valeur {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--fait);
    font-variant-numeric: tabular-nums;
  }
  .unite {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    margin-top: 0.15rem;
  }
  .libelle {
    font-size: 0.9rem;
    line-height: 1.4;
  }
  .src {
    margin-top: auto;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .etat-detail {
    max-width: var(--measure);
  }
  .etat-detail > summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--accent);
    padding: 0.4rem 0;
    margin-bottom: 0.5rem;
  }
  .note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    font-size: 0.88rem;
    margin-top: -0.25rem;
  }
  .nd {
    background: var(--empty-bg);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
    margin: 0;
    color: var(--muted);
  }
  .cartes {
    max-width: 48rem;
  }
  .carte {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    margin-bottom: 0.6rem;
  }
  .carte summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 0.85rem;
    padding: 1rem;
    cursor: pointer;
    list-style: none;
  }
  .carte summary::-webkit-details-marker {
    display: none;
  }
  .carte:hover {
    border-color: var(--accent);
  }
  .corps {
    display: grid;
    gap: 0.3rem;
  }
  .qui {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.6rem;
  }
  .nom {
    font-weight: 700;
    font-size: 0.98rem;
  }
  .parti {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .phrase {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    line-height: 1.45;
  }
  .nd-inline {
    color: var(--muted);
    font-style: italic;
  }
  .plus {
    align-self: center;
  }
  .plus::after {
    content: '+';
    font-size: 1.4rem;
    color: var(--accent);
  }
  .carte[open] .plus::after {
    content: '−';
  }
  .detail {
    display: grid;
    gap: 0.75rem;
    padding: 0 1rem 1rem;
    border-top: 1px solid var(--line);
  }
  .detail h3 {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin: 0.75rem 0 0;
  }
  .lien {
    margin: 0.25rem 0 0;
    font-weight: 600;
  }
  .sections {
    max-width: 48rem;
    margin-top: 2.5rem;
    border-bottom: 1px solid var(--line);
  }
  .promesse-bloc {
    display: grid;
    gap: 0.35rem;
  }
  .promesse-qui {
    margin: 0;
    font-weight: 600;
    font-size: 0.9rem;
  }
  /* Phones: two figures per row and tighter cards, so the page does not turn into a long column. */
  @media (max-width: 599px) {
    .chiffres-cles {
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }
    .chiffres-cles li {
      padding: 0.75rem;
    }
    .valeur {
      font-size: 1.35rem;
    }
    .libelle {
      font-size: 0.8rem;
    }
    .carte summary {
      gap: 0.6rem;
      padding: 0.85rem 0.75rem;
    }
    .phrase {
      font-size: 1rem;
    }
  }
</style>
