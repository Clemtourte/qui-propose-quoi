---
import Base from '../../layouts/Base.astro';
import ThemeGrid from '../../components/ThemeGrid.astro';
import { getCandidats, getCouverture, getThemes } from '../../lib/data';

const themes = await getThemes();
const candidats = await getCandidats();
const couverture = await getCouverture(themes, candidats);
---

<Base title="Thèmes">
  <div class="wrap">
    <h1>Thèmes</h1>
    <ThemeGrid themes={themes} couverture={couverture} total={candidats.length} />
  </div>
</Base>
