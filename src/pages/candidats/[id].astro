---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Item from '../../components/Item.astro';
import AvisCard from '../../components/AvisCard.astro';
import VerifCard from '../../components/VerifCard.astro';
import Section from '../../components/Section.astro';
import SourceRefs from '../../components/SourceRefs.astro';
import SourceList from '../../components/SourceList.astro';
import JusticeCard from '../../components/JusticeCard.astro';
import NatureTag from '../../components/NatureTag.astro';
import Legende from '../../components/Legende.astro';
import {
  getCandidats,
  getThemes,
  collectSources,
  visible,
  ISSUES,
  issueJustice,
  typo,
} from '../../lib/data';

export async function getStaticPaths() {
  const candidats = await getCandidats();
  return candidats.map((c) => ({ params: { id: c.id }, props: { candidat: c } }));
}

const { candidat } = Astro.props;
const c = candidat.data;
const id = candidat.id;
const vision = visible(c.vision);

const themes = await getThemes();
const themeById = new Map(themes.map((t) => [t.id, { id: t.id, titre: t.data.titre }]));

const entrees = await getCollection('entrees', ({ data }) => data.candidat.id === id);
const byRubrique = (r: string) =>
  entrees.filter((e) => e.data.rubrique === r).sort((a, b) => b.data.date.localeCompare(a.data.date));

// Programme measures are grouped by theme, in the theme order of the site.
const mesures = byRubrique('mesure');
const mesuresParTheme = themes
  .map((t) => ({ theme: t, items: mesures.filter((m) => m.data.theme?.id === t.id) }))
  .filter((g) => g.items.length > 0);

// Past record and past promises (promise vs. what was done) are read together.
const bilan = [...byRubrique('bilan'), ...byRubrique('promesse')].sort((a, b) => b.data.date.localeCompare(a.data.date));
const participation = byRubrique('participation');
// Entries filed elsewhere (programme, record) that also concern popular participation.
const participationAilleurs = entrees
  .filter((e) => e.data.aussi_participation && e.data.rubrique !== 'participation')
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
const declarations = byRubrique('declaration');
const soutiens = byRubrique('soutien_adversaire');

const avis = (await getCollection('avis', ({ data }) => data.candidats.some((x) => x.id === id))).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);
const verifications = (await getCollection('verifications', ({ data }) => data.candidat.id === id)).sort((a, b) =>
  b.data.declaration.date.localeCompare(a.data.declaration.date),
);
// Most recent step first, so ongoing cases come before old ones.
const lastStep = (j: { data: { etapes: { date: string }[] } }) =>
  j.data.etapes.map((e) => e.date).sort().at(-1) ?? '';
const justice = (await getCollection('justice', ({ data }) => data.candidat.id === id)).sort((a, b) =>
  lastStep(b).localeCompare(lastStep(a)),
);
// Cases against the candidate, then investigations into their campaigns where they are not charged.
const justicePerso = justice.filter((j) => j.data.concerne === 'candidat');
const justiceCampagne = justice.filter((j) => j.data.concerne === 'campagne');
const resumeJustice = ISSUES.map((i) => ({
  ...i,
  n: justicePerso.filter((j) => issueJustice(j.data) === i.id).length,
})).filter((i) => i.n > 0);

// Theme summaries, shown in "En 30 secondes" while no programme priorities are recorded.
const syntheses = (await getCollection('syntheses', ({ data }) => data.candidat.id === id))
  .map((s) => ({ s, theme: themes.find((t) => t.id === s.data.theme.id) }))
  .filter((x) => x.theme)
  .sort((a, b) => a.theme!.data.ordre - b.theme!.data.ordre);
const showSyntheses = !c.en_30_secondes?.propose.length && syntheses.length > 0;

const sources = await collectSources([
  c.candidature,
  c.en_30_secondes,
  ...(showSyntheses ? syntheses.map((x) => x.s.data) : []),
  ...vision,
  ...entrees.map((e) => e.data),
  ...avis.map((a) => a.data),
  ...verifications.map((v) => v.data),
  ...justice.map((j) => j.data),
]);

const r = c.recherches;
const itemProps = (e: (typeof entrees)[number]) => ({
  ...e.data,
  theme: e.data.theme ? themeById.get(e.data.theme.id) : undefined,
});
---

<Base title={`${c.prenom} ${c.nom}`} description={`${c.prenom} ${c.nom} (${c.parti}) : programme, bilan, sources.`}>
  <div class="wrap">
    <header class="hero">
      <p class="eyebrow">{c.parti}</p>
      <h1>{c.prenom} {c.nom}</h1>
      {c.fonction && <p class="fonction">{c.fonction}</p>}
      <Legende />
    </header>

    <section class="trente" aria-labelledby="s1">
      <h2 id="s1"><span class="num">1</span> En 30 secondes</h2>
      <div class="candidature">
        <NatureTag nature="fait" />
        <p>{c.candidature.texte}</p>
        <SourceRefs sources={c.candidature.sources} />
      </div>
      {
        c.en_30_secondes ? (
          <div class="resume">
            <NatureTag nature="fait" />
            <p>{typo(c.en_30_secondes.parcours)}</p>
            <SourceRefs sources={c.en_30_secondes.sources} />
          </div>
        ) : (
          <p class="nd-inline">
            <strong>Parcours : non documenté.</strong> {r.en_30_secondes ?? 'Pas encore recherché.'}
          </p>
        )
      }
      {
        c.en_30_secondes?.propose.length ? (
          <div class="resume">
            <NatureTag nature="position" />
            <p class="propose-titre">Propositions principales, d'après son programme&nbsp;:</p>
            <ul class="propose">
              {c.en_30_secondes.propose.map((p) => (
                <li>{typo(p)}</li>
              ))}
            </ul>
          </div>
        ) : (
          showSyntheses && (
            <div class="resume">
              <NatureTag nature="position" />
              <p class="propose-titre">Ses positions sur les thèmes déjà traités sur ce site&nbsp;:</p>
              <ul class="propose">
                {syntheses.map(({ s, theme }) => (
                  <li>
                    <a href={`/themes/${theme!.id}/`}>{theme!.data.titre}</a>&nbsp;: {typo(s.data.phrase)}
                  </li>
                ))}
              </ul>
              <SourceRefs sources={[...new Map(syntheses.flatMap((x) => x.s.data.sources).map((x) => [x.id, x])).values()]} />
            </div>
          )
        )
      }
    </section>

    <div class="sections">
      <Section id="vision" numero={2} titre="Vision d'ensemble et cohérence" count={vision.length} recherche={r.vision} open>
        {vision.map((v) => <Item {...v} />)}
      </Section>

      <Section id="programme" numero={3} titre="Programme" count={mesures.length} recherche={r.programme}>
        {
          mesuresParTheme.map((g) => (
            <div class="groupe">
              <h3 class="groupe-titre">
                <a href={`/themes/${g.theme.id}/`}>{g.theme.data.titre}</a>
              </h3>
              {g.items.map((e) => (
                <Item {...e.data} theme={undefined} />
              ))}
            </div>
          ))
        }
      </Section>

      <Section id="avis" numero={4} titre="Avis d'institutions sur son programme" count={avis.length} recherche={r.avis}>
        {avis.map((a) => <AvisCard avis={a} />)}
      </Section>

      <Section id="bilan" numero={5} titre="Bilan et promesses passées" count={bilan.length} recherche={r.bilan}>
        {bilan.map((e) => <Item {...itemProps(e)} />)}
      </Section>

      <Section id="verifications" numero={6} titre="Affirmations vérifiées" count={verifications.length} recherche={r.verifications}>
        {verifications.map((v) => <VerifCard verification={v} />)}
      </Section>

      <Section id="justice" numero={7} titre="Décisions de justice" count={justice.length} recherche={r.justice}>
        {
          resumeJustice.length > 0 && (
            <p class="resume-justice">
              <strong>En bref&nbsp;:</strong>{' '}
              {resumeJustice.map((i, k) => (
                <>
                  {k > 0 && ' · '}
                  {i.n} {i.n > 1 ? i.pluriel : i.label}
                </>
              ))}
              .
            </p>
          )
        }
        {justicePerso.map((j) => <JusticeCard j={j} />)}
        {
          justiceCampagne.length > 0 && (
            <>
              <h3 class="sous-bloc">Enquêtes visant ses campagnes électorales</h3>
              <p class="muted small">
                Procédures sur le financement ou l'organisation de ses campagnes, dans lesquelles aucune mise en cause
                personnelle n'est rapportée.
              </p>
              {justiceCampagne.map((j) => <JusticeCard j={j} />)}
            </>
          )
        }
        {r.justice && <p class="muted perimetre">{typo(r.justice)}</p>}
      </Section>

      <Section
        id="participation"
        numero={8}
        titre="Place laissée à la population"
        count={participation.length + participationAilleurs.length}
        recherche={r.participation}
      >
        {participation.map((e) => <Item {...itemProps(e)} />)}
        {
          participationAilleurs.length > 0 && (
            <div class="voir-aussi">
              <p class="propose-titre">Voir aussi, dans d'autres sections de cette page&nbsp;:</p>
              <ul>
                {participationAilleurs.map((e) => (
                  <li>
                    {typo(e.data.titre)}
                    {e.data.theme && (
                      <>
                        {' '}
                        (<a href={`/themes/${e.data.theme.id}/`}>{themeById.get(e.data.theme.id)?.titre}</a>)
                      </>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </Section>

      <Section id="declarations" numero={9} titre="Déclarations et polémiques" count={declarations.length} recherche={r.declarations}>
        {declarations.map((e) => <Item {...itemProps(e)} />)}
      </Section>

      <Section id="soutiens" numero={10} titre="Ce qu'en disent soutiens et adversaires" count={soutiens.length} recherche={r.soutiens}>
        {soutiens.map((e) => <Item {...itemProps(e)} />)}
      </Section>
    </div>

    <SourceList sources={sources} derniereVerification={c.derniere_verification} />
  </div>
</Base>

<style>
  .hero {
    margin-bottom: 1.5rem;
  }
  .fonction {
    color: var(--muted);
    font-size: 1.05rem;
    max-width: var(--measure);
  }
  .trente {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem;
    margin-bottom: 2rem;
    max-width: 48rem;
  }
  .trente h2 {
    font-size: 1.3rem;
  }
  .num {
    color: var(--muted);
    font-weight: 400;
    margin-right: 0.4rem;
  }
  .candidature p {
    margin: 0.5rem 0 0;
  }
  .resume {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .propose-titre {
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  .propose {
    margin: 0;
    padding-left: 1.2rem;
  }
  .propose li {
    margin-bottom: 0.3rem;
  }
  .voir-aussi {
    margin-top: 1rem;
    font-size: 0.92rem;
  }
  .nd-inline {
    margin: 1rem 0 0;
    color: var(--muted);
    background: var(--empty-bg);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
  }
  .sections {
    max-width: 48rem;
    border-bottom: 1px solid var(--line);
  }
  .groupe {
    display: grid;
    gap: 0.75rem;
  }
  .groupe + .groupe {
    margin-top: 0.75rem;
  }
  .groupe-titre {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }
  .resume-justice {
    margin: 0 0 1rem;
  }
  .sous-bloc {
    font-family: var(--font-sans);
    font-size: 1rem;
    margin: 1.5rem 0 0.25rem;
  }
  .small {
    font-size: 0.85rem;
    margin-top: 0;
  }
  .perimetre {
    font-size: 0.85rem;
  }
</style>
