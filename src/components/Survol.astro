---
// Overview table: one row per candidate, one column per key question of the theme.
// It summarises declared positions; the detail and sources are in the cards below.
import { typo, entryAnchor, absenceSur, SANS_REPONSE, type CandidatTheme } from '../lib/data';

interface Props {
  questions: Array<{ id: string; libelle: string }>;
  parCandidat: CandidatTheme[];
  themeId: string;
}

const { questions, parCandidat, themeId } = Astro.props;
---

<div class="scroll" tabindex="0" role="region" aria-labelledby="survol-titre">
  <table>
    <thead>
      <tr>
        <th scope="col">Candidat</th>
        {questions.map((q) => <th scope="col">{q.libelle}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        parCandidat.map(({ candidat: c, synthese, mesures }) => (
          <tr>
            <th scope="row">
              <a href={`#carte-${c.id}`}>
                {c.data.prenom} {c.data.nom}
              </a>
            </th>
            {questions.map((q) => {
              const r = synthese?.data.reponses[q.id];
              if (!r) {
                // Without any summary the cell says why: searched and not found, programme awaited, not searched yet.
                const a = synthese ? null : absenceSur(c, themeId);
                return (
                  <td class="nd" title={a?.note}>
                    {a ? a.label : SANS_REPONSE}
                  </td>
                );
              }
              // Only the first clause of the reference fits the table; the rest is in the card.
              // Links to the measure card detailing this answer, else to the candidate's card.
              const detail = mesures.find((e) => e.data.questions.includes(q.id));
              const repere = mesures.flatMap((e) => e.data.reperes.filter((x) => x.question === q.id))[0];
              return (
                <td>
                  <a class="cellule" href={detail ? `#${entryAnchor(detail.id)}` : `#carte-${c.id}`}>
                    {typo(r)}
                  </a>
                  {repere && (
                    <span class="repere">
                      {typo(repere.mesure)} : {typo(repere.equivalent.split(' ; ')[0])}
                    </span>
                  )}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .cellule {
    color: inherit;
    text-decoration: underline dotted var(--muted);
    text-underline-offset: 3px;
  }
  .cellule:hover {
    color: var(--accent);
    text-decoration-style: solid;
  }
  .repere {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  table {
    width: 100%;
    min-width: 36rem;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--line);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    font-size: 0.75rem;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  td {
    min-width: 11rem;
  }
  tbody th {
    font-weight: 600;
    min-width: 7rem;
    position: sticky;
    left: 0;
    background: var(--surface);
  }
  tbody th a {
    color: var(--text);
  }
  .nd {
    color: var(--muted);
    font-style: italic;
  }
</style>
