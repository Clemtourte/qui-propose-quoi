---
// Overview table: one row per candidate, one column per key question of the theme.
// It summarises declared positions; the detail and sources are in the cards below.
import { typo, entryAnchor, absenceSur, SANS_REPONSE, type CandidatTheme } from '../lib/data';

interface Props {
  questions: Array<{ id: string; libelle: string }>;
  parCandidat: CandidatTheme[];
  themeId: string;
}

const { questions, parCandidat, themeId } = Astro.props;
---

<div class="survol-bloc" data-survol>
{
  // Phones show one question at a time, picked here; the script reveals these chips.
  questions.length > 1 && (
    <div class="choix" role="group" aria-label="Question affichée" hidden>
      {questions.map((q, i) => (
        <button type="button" class="chip" data-q={q.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          {q.libelle}
        </button>
      ))}
    </div>
  )
}
<div class="scroll" tabindex="0" role="region" aria-labelledby="survol-titre">
  <table>
    <thead>
      <tr>
        <th scope="col">Candidat</th>
        {questions.map((q) => <th scope="col" data-q={q.id}>{q.libelle}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        parCandidat.map(({ candidat: c, synthese, mesures }) => (
          <tr>
            <th scope="row">
              <a href={`#carte-${c.id}`}>
                {c.data.prenom} {c.data.nom}
              </a>
            </th>
            {questions.map((q) => {
              const r = synthese?.data.reponses[q.id];
              if (!r) {
                // Without any summary the cell says why: searched and not found, programme awaited, not searched yet.
                const a = synthese ? null : absenceSur(c, themeId);
                return (
                  <td class="nd" title={a?.note} data-q={q.id}>
                    {a ? a.label : SANS_REPONSE}
                  </td>
                );
              }
              // Only the first clause of the reference fits the table; the rest is in the card.
              // Links to the measure card detailing this answer, else to the candidate's card.
              const detail = mesures.find((e) => e.data.questions.includes(q.id));
              const repere = mesures.flatMap((e) => e.data.reperes.filter((x) => x.question === q.id))[0];
              return (
                <td data-q={q.id}>
                  <a class="cellule" href={detail ? `#${entryAnchor(detail.id)}` : `#carte-${c.id}`}>
                    {typo(r)}
                  </a>
                  {repere && (
                    <span class="repere">
                      {typo(repere.mesure)} : {typo(repere.equivalent.split(' ; ')[0])}
                    </span>
                  )}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
</div>

<script>
  // On phones, only the column of the chosen question is shown (see the media query below).
  for (const bloc of document.querySelectorAll<HTMLElement>('[data-survol]')) {
    const choix = bloc.querySelector<HTMLElement>('.choix');
    if (!choix) continue;
    const chips = [...choix.querySelectorAll<HTMLButtonElement>('.chip')];
    const montrer = (q: string) => {
      for (const chip of chips) chip.setAttribute('aria-pressed', String(chip.dataset.q === q));
      for (const cell of bloc.querySelectorAll<HTMLElement>('[data-q]:not(.chip)')) {
        cell.classList.toggle('autre', cell.dataset.q !== q);
      }
    };
    for (const chip of chips) chip.addEventListener('click', () => montrer(chip.dataset.q!));
    choix.hidden = false;
    bloc.classList.add('une-question');
    montrer(chips[0].dataset.q!);
  }
</script>

<style>
  .choix {
    display: none;
  }
  .chip {
    font: inherit;
    font-size: 0.85rem;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    cursor: pointer;
  }
  .chip[aria-pressed='true'] {
    color: var(--surface);
    background: var(--text);
    border-color: var(--text);
    font-weight: 600;
  }
  /* Phones: a two-column table (candidate, answer to the chosen question) instead of a wide scroll. */
  @media (max-width: 599px) {
    .une-question .choix {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 0.75rem;
    }
    .une-question .autre {
      display: none;
    }
    .une-question table {
      min-width: 0;
    }
    .une-question td {
      min-width: 0;
    }
    .une-question tbody th {
      position: static;
      width: 38%;
    }
  }
  .cellule {
    color: inherit;
    text-decoration: underline dotted var(--muted);
    text-underline-offset: 3px;
  }
  .cellule:hover {
    color: var(--accent);
    text-decoration-style: solid;
  }
  .repere {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  table {
    width: 100%;
    min-width: 36rem;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--line);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    font-size: 0.75rem;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  td {
    min-width: 11rem;
  }
  tbody th {
    font-weight: 600;
    min-width: 7rem;
    position: sticky;
    left: 0;
    background: var(--surface);
  }
  tbody th a {
    color: var(--text);
  }
  .nd {
    color: var(--muted);
    font-style: italic;
  }
</style>
