---
// One sourced piece of information, styled by its level (fact / declared position / attributed judgement).
import NatureTag from './NatureTag.astro';
import SourceRefs from './SourceRefs.astro';
import { formatDate, typo } from '../lib/data';

type Nature = 'fait' | 'position' | 'jugement';

interface Props {
  nature: Nature;
  auteur?: string;
  titre?: string;
  texte: string;
  date: string;
  sources: Array<{ collection: 'sources'; id: string }>;
  citation?: { texte: string; date: string; contexte: string };
  promesse?: { texte: string; date: string; contexte: string };
  chiffres?: Array<{ libelle: string; valeur: string; nature: Nature }>;
  reperes?: Array<{ mesure: string; equivalent: string; calcul: string; sources: Array<{ collection: 'sources'; id: string }> }>;
  // Anchor so the overview table can link to this item.
  id?: string;
  theme?: { id: string; titre: string };
  // Tighter layout for narrow columns (comparator).
  compact?: boolean;
  // Who the item is about, read before the title by screen readers and search results only
  // (on theme pages the card already shows the name).
  qui?: string;
}

const {
  nature,
  auteur,
  titre,
  texte,
  date,
  sources,
  citation,
  promesse,
  chiffres = [],
  reperes = [],
  id,
  theme,
  compact = false,
  qui,
} = Astro.props;
---

<!-- The anchor sits on the title when there is one, so search results can point to this item. -->
<article class:list={['item', nature, { compact }]} id={titre ? undefined : id}>
  <div class="meta">
    <NatureTag nature={nature} auteur={auteur} />
    <time datetime={date}>{formatDate(date)}</time>
    {theme && <a class="theme" href={`/themes/${theme.id}/`}>{theme.titre}</a>}
  </div>
  {
    titre && (
      <h3 id={id}>
        {qui && <span class="visually-hidden">{qui}&nbsp;: </span>}
        {typo(titre)}
      </h3>
    )
  }
  {
    citation && (
      <figure>
        <blockquote>«&nbsp;{typo(citation.texte)}&nbsp;»</blockquote>
        <figcaption>
          {formatDate(citation.date)}, {citation.contexte}
        </figcaption>
      </figure>
    )
  }
  {
    promesse && (
      <figure class="promesse">
        <figcaption class="promesse-label">Promesse</figcaption>
        <blockquote>«&nbsp;{typo(promesse.texte)}&nbsp;»</blockquote>
        <figcaption>
          {formatDate(promesse.date)}, {promesse.contexte}
        </figcaption>
      </figure>
    )
  }
  {promesse && <p class="promesse-label">Ce qui a été fait</p>}
  <p>{typo(texte)}</p>
  {
    chiffres.length > 0 && (
      <dl class="chiffres">
        {chiffres.map((c) => (
          <div class={c.nature}>
            <dt>{c.libelle}</dt>
            <dd>{typo(c.valeur)}</dd>
          </div>
        ))}
      </dl>
    )
  }
  {
    reperes.length > 0 && (
      <div class="reperes">
        <p class="reperes-titre">Pour se repérer</p>
        <ul>
          {reperes.map((r) => (
            <li>
              <strong>{typo(r.mesure)}</strong> : {typo(r.equivalent)}
              <details>
                <summary>Calcul et sources</summary>
                <p>{typo(r.calcul)}</p>
                <SourceRefs sources={r.sources} />
              </details>
            </li>
          ))}
        </ul>
      </div>
    )
  }
  <SourceRefs sources={sources} />
</article>

<style>
  .reperes {
    margin: 0.6rem 0;
    padding: 0.6rem 0.8rem;
    background: var(--empty-bg);
    border-radius: var(--radius);
    font-size: 0.9rem;
  }
  .reperes-titre {
    margin: 0 0 0.3rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .reperes ul {
    margin: 0;
    padding-left: 1.1rem;
  }
  .reperes summary {
    cursor: pointer;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .reperes details p {
    margin: 0.3rem 0;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .item {
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 4px solid var(--fait);
    border-radius: var(--radius);
    padding: 0.9rem 1rem;
  }
  .item.position {
    border-left-color: var(--position);
  }
  .item.jugement {
    border-left-color: var(--jugement);
    border-left-style: dashed;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .theme {
    color: var(--muted);
  }
  .promesse {
    border-left: 2px solid var(--line);
    padding-left: 0.75rem;
  }
  .promesse-label {
    font-size: 0.75rem;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin: 0 0 0.15rem;
  }
  .compact {
    padding: 0.7rem 0.75rem;
    font-size: 0.92rem;
  }
  .compact h3 {
    font-size: 0.95rem;
  }
  .compact .chiffres {
    grid-template-columns: 1fr;
  }
  h3 {
    font-family: var(--font-sans);
    font-size: 1.02rem;
    font-weight: 650;
    margin-bottom: 0.35rem;
  }
  p {
    margin: 0;
  }
  figure {
    margin: 0 0 0.6rem;
  }
  blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-style: italic;
  }
  figcaption {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .chiffres {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.5rem;
    margin: 0.75rem 0 0;
  }
  .chiffres div {
    border-radius: var(--radius);
    padding: 0.5rem 0.65rem;
    background: var(--fait-bg);
  }
  .chiffres .position {
    background: var(--position-bg);
  }
  .chiffres .jugement {
    background: var(--jugement-bg);
  }
  dt {
    font-size: 0.78rem;
    color: var(--muted);
  }
  dd {
    margin: 0;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }
</style>
