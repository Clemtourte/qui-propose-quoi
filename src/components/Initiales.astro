---
// Neutral initials badge: the same colour for every candidate, never a party colour.
interface Props {
  prenom: string;
  nom: string;
  size?: 'sm' | 'md' | 'lg';
}

const { prenom, nom, size = 'md' } = Astro.props;
// "Le Pen" -> "LP", "Mélenchon" -> "M": first letter of each word of the last name.
const initiales = (prenom[0] + nom.split(/\s+/).map((w) => w[0]).join('')).toUpperCase();
---

<span class:list={['ini', size]} aria-hidden="true">{initiales}</span>

<style>
  .ini {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    border-radius: 50%;
    background: var(--accent-bg);
    color: var(--accent);
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .sm {
    width: 2.1rem;
    height: 2.1rem;
    font-size: 0.78rem;
  }
  .md {
    width: 2.75rem;
    height: 2.75rem;
    font-size: 0.95rem;
  }
  .lg {
    width: 4rem;
    height: 4rem;
    font-size: 1.35rem;
  }
</style>
