---
// A collapsible page section. An empty section stays visible with "Non documenté"
// and, when available, what was searched.
interface Props {
  id: string;
  numero?: number;
  titre: string;
  count: number;
  recherche?: string;
  open?: boolean;
}

const { id, numero, titre, count, recherche, open = false } = Astro.props;
const empty = count === 0;
// A section is "searched" when a note says what was looked for; notes that start with "Pas encore" say the opposite.
const cherche = !!recherche && !/^pas encore/i.test(recherche.trim());
const etat = cherche ? 'Rien trouvé' : 'Pas encore cherché';
---

<details class:list={['section', { vide: empty }]} id={id} open={open}>
  <summary>
    {numero !== undefined && <span class="num">{numero}</span>}
    <span class="titre">{titre}</span>
    <span class:list={['count', { empty }]}>{empty ? etat : count}</span>
  </summary>
  <div class="body">
    {
      empty ? (
        <p class="nd">
          <strong>{etat}.</strong> {cherche ? recherche : 'Section pas encore recherchée.'}
        </p>
      ) : (
        <>
          <slot />
          {cherche && (
            <p class="cherche">
              <strong>Ce qui a été cherché :</strong> {recherche}
            </p>
          )}
        </>
      )
    }
  </div>
</details>

<style>
  .section {
    border-top: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1rem 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    font-size: 1.4rem;
    line-height: 1;
    color: var(--muted);
  }
  details[open] > summary::after {
    content: '−';
  }
  summary {
    align-items: center;
  }
  .num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--surface);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .count:not(.empty) {
    color: var(--accent);
    border-color: var(--accent);
    font-weight: 700;
  }
  /* Sections not yet documented stay visible but recede. */
  .vide .titre {
    color: var(--muted);
    font-weight: 500;
    font-size: 1.1rem;
  }
  .vide .num {
    background: var(--line);
    color: var(--muted);
  }
  .vide summary {
    padding: 0.6rem 0;
  }
  .titre {
    flex: 1;
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 650;
  }
  .count {
    font-size: 0.78rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0 0.5rem;
    white-space: nowrap;
  }
  .count.empty {
    font-style: italic;
  }
  .body {
    display: grid;
    gap: 0.75rem;
    padding: 0 0 1.5rem;
  }
  .cherche {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .nd {
    background: var(--empty-bg);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
    margin: 0;
    color: var(--muted);
  }
</style>
